{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "package.json",
      "**/node_modules/**",
      ".github/**",
      ".gitignore",
      "base/**",
      "docs/**",
      "src/**",
      "out/**",
      "tools/**",
      "**/*.md",
      ".git/**",
      "**/.DS_Store",
      "android.keystore",
      "twa-manifest.json",
      "*.apk",
      "*.aab",
      "build/**",
      "push.sh",
      "push.bat"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/app.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/free/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "base/firestore.rules"
  }
}